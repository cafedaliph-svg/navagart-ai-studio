{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navagart AI Studio",
  "version": "0.1.0",
  "identifier": "com.navagart.aistudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Navagart AI Studio",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "AI image and video creation studio",
    "longDescription": "Navagart AI Studio is a Windows desktop workspace for AI image and video generation."
  }
}
